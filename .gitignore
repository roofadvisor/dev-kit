# Generated by kit/scripts/build_tokens.mjs — rebuild it, never commit it.
kit/dist/

# Playwright, installed per the README so the render gates can run.
node_modules/

# Python bytecode, regenerated by every test run that shells into scripts/.
__pycache__/
*.pyc

# The hooks' local state: the verify marker (verify-record.sh, scripts/dev-kit-verify-mark.sh)
# and telemetry (session-context.sh, guard.sh). Never shared.
.claude/.last-verify
.claude/.session-log
.claude/.enforcement-log
